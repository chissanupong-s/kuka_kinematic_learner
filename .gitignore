# ============================================================
# Added 2026-05-09: exclude large training artefacts and outputs
# ============================================================

# PyTorch model checkpoints (regeneratable; >50MB each)
*.pt
*.pth
*.ckpt
!**/requirements*.txt   # safety: keep requirements files even if regex catches anything

# TensorBoard event files
events.out.tfevents.*
*.tfevents.*

# Tier-4 experiment outputs: track scripts (.sh, .py) and small text outputs
# (summary.txt, logs/*.log) for cross-machine coordination via this repo;
# ignore the heavy artefacts (model checkpoints, tensorboard binary).
original/ext_script/scripts/train/tier4_runs/**/ckpts/
original/ext_script/scripts/train/tier4_runs/**/tb/
original/ext_script/scripts/train/tier4_runs/**/models/

# Pre-edit snapshots — kept locally on each machine, NOT shared via git
originals/

# Older model-tracking checkpoints
original/ext_script/scripts/train/model_tracking/*
# Keep only the Stage-2 shared meta-kinematics checkpoint (used as --ckpt for all Stage-3 adaptation experiments)
!original/ext_script/scripts/train/model_tracking/multitask_fk_best.pt
!original/ext_script/scripts/train/model_tracking/README.md
!original/ext_script/scripts/train/model_tracking/setup_checkpoints.sh

# Report drafts: keep only the latest, ignore originals/backups
original/ext_script/scripts/train/report_resources/report_drafts/originals/

# Optional: ignore intermediate report drafts (keep only Final ones)
# Uncomment if you want to ignore numbered version drafts:
# original/ext_script/scripts/train/report_resources/report_drafts/*post_audit_v*.docx

# Conference paper PDFs (keep .tex source, ignore compiled output)
conference_resources/*.pdf
conference_resources/*.aux
conference_resources/*.log
conference_resources/*.out
conference_resources/*.bbl
conference_resources/*.blg
conference_resources/*.synctex.gz


# HF token (never commit)
.hf_token

# 360 MB of intermediate experiment results (regeneratable; not needed for report submission)
original/ext_script/scripts/train/report_resources/results/
